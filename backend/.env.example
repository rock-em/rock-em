# Local HTTP only. Production defaults to secure HTTPS cookies.
AUTH_COOKIE_SECURE=false

# Password reset email delivery (STARTTLS, usually port 587).
# Leave SMTP_ADDR unset to disable reset requests until a provider is configured.
# SMTP_ADDR="smtp.your-provider.example:587"
# SMTP_USERNAME="your-smtp-username"
# SMTP_PASSWORD="your-smtp-password"
# SMTP_FROM="rock em <accounts@your-domain.example>"
# PUBLIC_ORIGIN="https://rockem.xyz"
