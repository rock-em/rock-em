        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProblemInput"
              }
            }
          }
        },
        "description": "Requires a nonempty languages map of complete language data. Returns Location header. Requires admin role."
      }
    },
    "/api/problems/{slug}": {
      "get": {
        "operationId": "GetProblem",
        "summary": "GetProblem",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_+-]{0,31}$",
              "description": "Canonical lowercase language name, e.g. python or javascript. URL-encode plus signs.",
              "default": "python"
            }
          }
        ],
        "description": "Defaults to python. Missing language returns 404 with code language_not_available and current languages; never silently falls back."
      },
      "put": {
        "operationId": "UpdateProblem",
        "summary": "UpdateProblem",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
