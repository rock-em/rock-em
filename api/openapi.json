                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProblemInput"
              }
            }
          }
        },
        "description": "Replaces common metadata; merges supplied languages by key. Omitted languages are preserved. Requires admin role."
      },
      "delete": {
        "operationId": "DeleteProblem",
        "summary": "DeleteProblem",
        "responses": {
          "204": {
            "description": "Success"
